# ── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# Белый список Telegram ID через запятую (раздел 10.1).
# Можно оставить пустым и вести список в БД (таблица allowed_users).
WHITELIST_TELEGRAM_IDS=

# ── Провайдеры моделей (раздел 10.2 — выбор меняется в одном месте) ─────────
# Какой провайдер LLM/Vision использовать: anthropic | (в будущем) openai, local...
LLM_PROVIDER=anthropic
# Модель в рамках провайдера. Для Anthropic — самая способная мультимодальная.
LLM_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=

# Провайдер погоды: open_meteo | (в будущем) openweather...
WEATHER_PROVIDER=open_meteo

# Эмбеддинги для поиска дублей (Цель 1). voyage | none.
# Без VOYAGE_API_KEY поиск дублей мягко отключается (вердикт всё равно работает).
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3
VOYAGE_API_KEY=

# Анализ актуальных трендов (чтобы лук был современным). anthropic | none.
TREND_PROVIDER=anthropic
TREND_TTL_DAYS=7

# ── База данных ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/aifashion

# ── Хранилище фото (S3-совместимое) ────────────────────────────────────────
STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=aifashion
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ── Прочее ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
